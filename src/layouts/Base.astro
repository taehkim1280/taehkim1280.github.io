---
const { title = 'Portfolio', description = 'Projects and work', pageTitle } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.ico?" />
  <title>{pageTitle ? `${pageTitle} — ${title}` : title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#b8d3f5; 
      --headerbg:#fdf9ea; 
      --modalheadbg:#9cb6ee; 
      --modaltitletext:#152b55;
      --modalbuttontext:#ffffff;
      --modalbg:#f3f2f1; 
      --modalbgbackdrop:#ebebeb; 
      --modalbutton:#6588ca; 
      --gradient: #ffffff;
      --captionbox:#f5e8df; 
      --titletext2:#1048b1;
      --smalltext:#3f260f; 
      --linktext:#3b2a18; 
      --footer: #3f69b8;
      --headergradientspread: 60%;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; 
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; 
      background: var(--bg);
    }
    a{color:var(--linktext); text-decoration:none}
    a:hover{text-decoration:underline}

    .headerbackground{
      width:100%;background: var(--headerbg);
    }
    .header{
      max-width:1100px; margin:0 auto; padding:24px 16px 0px;
      box-sizing:content-box;
    }
    .container{max-width:1100px; margin:0 auto; padding:0px 16px 64px;}
    header.nav{display:flex; align-items:flex-end; justify-content:space-between; gap:16px; padding:20px 0 8px;}
    .brand{font-weight:800; letter-spacing:-0.02em; font-size:clamp(20px,3.6vw,28px)}

    nav a{color:--linktext; margin-left:14px}
    nav a[aria-current="page"]{color:--linktext; font-weight:600}

    :global(.page-title1){color:var(--titletext2); font-size:clamp(22px,4vw,30px); margin:.2rem 0;}
    
    :global(.pageheader){
      width:100%;background: var(--headerbg);
      mask-image: linear-gradient(to bottom, black var(--headergradientspread), transparent 100%);
      /* Safari/Webkit prefix for best compatibility */
      -webkit-mask-image: linear-gradient(to bottom, black var(--headergradientspread), transparent 100%);
    }    
    :global(.pageheadercontainer){
      max-width:1100px; margin:0 auto; padding:4px 16px 40px;
    }
    :global(.pagecontainer){
      max-width:1100px; margin:0 auto; padding:0px 16px 64px;
    }
    :global(.intro){color:var(--smalltext); margin-top:4px; font-size: 18px;}
    footer{color:var(--smalltext); font-size:13px; padding-top:24px; border-top:1px solid var(--footer); margin-top:32px}
  </style>
</head>
<body>
  <div class="headerbackground">
    <div class="header">
      <header class="nav">
        <div class="brand"><a href="/">Taehoon Kim</a></div>
        <nav>
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Projects</a>
          <!-- <a href="/hobbies" aria-current={Astro.url.pathname.startsWith('/hobbies') ? 'page' : undefined}>Hobbies</a> -->
          <a href="/info" aria-current={Astro.url.pathname.startsWith('/info') ? 'page' : undefined}>Info</a>
        </nav>
      </header>
    </div>
  </div>
  <slot />
  <div class="container">
    <footer>
      © {new Date().getFullYear()} Taehoon Kim • Built with Astro • <a href="https://github.com/withastro/astro">Docs</a>
    </footer>
  </div>
</body>
</html>
