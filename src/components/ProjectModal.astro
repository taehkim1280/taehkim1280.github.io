---
interface Image { src: string; caption?: string }
interface Project { title: string; src: string; caption?: string; tags?: string[]; gallery?: Image[]; description?: string }

const { projects = [] as Project[], galleryId } = Astro.props;

// Create unique DOM IDs based on the galleryId
const modalRootId = `modal-root-${galleryId}`;
const dataScriptId = `proj-data-${galleryId}`;
---

<script type="application/json" id={dataScriptId} set:html={JSON.stringify(projects)}></script>

<div id={modalRootId} class="lb" aria-hidden="true">
  <div class="lb-backdrop" data-close></div>
  <div class="lb-dialog" role="dialog" aria-modal="true" aria-label="Project viewer">
    <div class="lb-head">
      <div class="lb-title" data-el="title"></div>
      <div class="lb-actions">
        <button class="btn" data-action="prev" aria-label="Previous">←</button>
        <button class="btn" data-action="next" aria-label="Next">→</button>
        <button class="btn" data-action="close" aria-label="Close">✕</button>
      </div>
    </div>
    <div class="lb-body">
      <div class="strip" data-el="strip"></div>
    </div>
  </div>
</div>

<script define:vars={{ galleryId, modalRootId, dataScriptId }}>
  (function(){
    const root = document.getElementById(modalRootId);
    const dataEl = document.getElementById(dataScriptId);
    if (!root || !dataEl) return;

    const data = JSON.parse(dataEl.textContent || '[]');
    const title = root.querySelector('[data-el="title"]');
    const strip = root.querySelector('[data-el="strip"]');
    
    let pIndex = 0;

    function buildSlides(proj) {
      if (!strip) return;
      const gal = (proj.gallery && proj.gallery.length) ? proj.gallery : (proj.src ? [{src: proj.src, caption: proj.caption}] : []);
      strip.innerHTML = gal.map(g =>
        `<figure class="slide">
          <img src="${g.src}" alt="${(proj.title||'').replace(/"/g, '&quot;')}" />
          ${g.caption ? `<figcaption class="cap">${g.caption}</figcaption>` : ''}
        </figure>`
      ).join('');
    }

    function open(index) {
      pIndex = index;
      buildSlides(data[pIndex] || {});
      if(title) title.textContent = data[pIndex]?.title || '';
      
      root.classList.add('open');
      root.setAttribute('aria-hidden', 'false');
      document.addEventListener('keydown', onKeys);
      document.body.style.overflow = 'hidden';
    }

    function close() {
      root.classList.remove('open');
      root.setAttribute('aria-hidden', 'true');
      document.removeEventListener('keydown', onKeys);
      document.body.style.overflow = '';
    }

    function nav(dir) {
      pIndex = (pIndex + dir + data.length) % data.length;
      buildSlides(data[pIndex]);
      if(title) title.textContent = data[pIndex]?.title || '';
    }

    function onKeys(e) {
      if(e.key === 'Escape') close();
      if(e.key === 'ArrowRight') nav(1);
      if(e.key === 'ArrowLeft') nav(-1);
    }

    // Listen for the specific custom event for THIS gallery
    document.addEventListener('open-project-modal', (e) => {
      if (e.detail && e.detail.id === galleryId) open(e.detail.index);
    });

    root.addEventListener('click', (e) => {
      const t = e.target;
      if (t.dataset.close !== undefined || t.closest('[data-action="close"]')) close();
      if (t.closest('[data-action="prev"]')) nav(-1);
      if (t.closest('[data-action="next"]')) nav(1);
    });
  })();
</script>

<!-- Styling -->
<style is:global>
  .zoom-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 2147483647;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: zoom-out;
    animation: zoomIn 0.18s ease;
  }
  .zoom-img {
    width: 100vw;    
    height: 100vh;   
    object-fit: contain; 
    box-shadow: 0 0 40px rgba(0,0,0,0.6);
  }
  @keyframes zoomIn {
    from { transform: scale(0.97); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }
  .slide{
    position: relative;
    scroll-snap-align:start;
    max-width: 85%;
    display: grid;
    align-items: center;
    justify-items: stretch;
    margin: 0 auto;
    margin-bottom: 50px;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }
  @media (max-width: 910px) { .slide { max-width: 90%; } }
  .slide img{
    max-width:100%;
    width: 100%;
    margin: 0 auto;
    height: auto;
  }
  .slide .cap{
    line-height: 20px; 
    padding-bottom: 5px;
    margin: 20px;
    overflow: hidden;
    color:var(--smalltext);
    font-size: 18px;
    white-space: pre-wrap;
    
  }
</style>
<style>
  :global(.lb){
    position: fixed;
    inset: 0;
    backdrop-filter: blur(6px) brightness(0.8);
    background: rgba(0, 0, 0, 0.123);
    display: none;
    z-index: 999;
    justify-content: center;  
    align-items: center;      
  }
  :global(.lb.open){ display: flex; }
  :global(.lb-backdrop){
    position:absolute; inset:0;
    background: var(--modalbgbackdrop);
    background: transparent;
    backdrop-filter: none;
  }
  :global(.lb-dialog){
    position: relative;
    width: 70%;                 
    height: 100%;       
    background: var(--modalheadbg);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    display: flex;
    flex-direction: column;
    z-index: 10000;
  }
  @media (max-width: 910px) { .lb-dialog { width: 100%; } }
  :global(.lb-head){
    display:flex; align-items:center; justify-content:space-between;
    padding:12px 16px;
  }
  :global(.lb-title){ font-size: 18px; font-weight:600; color:var(--modaltitletext); }
  :global(.lb-actions){ display:flex; gap:8px }
  :global(.btn){
    appearance:none; background:var(--modalbutton); border:0px;
    color:var(--modalbuttontext); border-radius:10px; padding:8px 10px; cursor:pointer
  }
  :global(.lb-body) {
    display:flex; align-items:center; justify-content:center;
    flex: 1 1 auto;
    min-height: 0;             
    overflow: hidden;          
    padding-top:10px;
    background: var(--modalbg);
  }
  .strip{
    display: block;
    width: 100%;
    height: 100%;
    overflow-y:auto;
    overscroll-behavior-y:contain;
    scroll-snap-type: none;
    -webkit-overflow-scrolling:touch;
  }
  
</style>