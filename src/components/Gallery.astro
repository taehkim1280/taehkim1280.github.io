---
import ProjectModal from './ProjectModal.astro';
interface Item { title: string; src: string; caption?: string; tags?: string[] }

const { items = [] as Item[] } = Astro.props;

// Generate a random ID for this gallery
const galleryId = 'gallery-' + Math.random().toString(36).slice(2, 9);
---

<div class="gallery-container" id={galleryId}>
  <div class="gallery">
    {items.map((p, idx) => (
      <button class="tile" data-idx={idx} aria-label={`Open ${p.title}`} type="button">
        <figure>
          <img src={p.src} alt={p.title} loading="lazy" />
          <figcaption>
            <div class="t">{p.title}</div>
            {p.caption && <div class="c">{p.caption}</div>}
          </figcaption>
        </figure>
      </button>
    ))}
  </div>
</div>

<ProjectModal projects={items} galleryId={galleryId} />

<script define:vars={{ galleryId }}>
  const container = document.getElementById(galleryId);
  if (container) {
    const tiles = container.querySelectorAll('.tile');
    tiles.forEach(btn => {
      btn.addEventListener('click', () => {
        // Dispatch event with the Unique ID
        document.dispatchEvent(new CustomEvent('open-project-modal', {
          detail: { id: galleryId, index: Number(btn.dataset.idx) }
        }));
      });
    });
  }
</script>

<style>
  :root { --col: 438px; --gap: 16px; }
  .gallery-container {
    width: min(100%, calc(2*var(--col) + var(--gap)));
    margin: 0 auto;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, var(--col));
    gap: var(--gap);
  }
  @media (max-width: 910px) { .gallery { grid-template-columns: 1fr; } }
  .tile {
    break-inside: avoid;
    width: 100%;
    display: block;
    margin: 0 0 0px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: inherit;
  }
  figure {
    width: 100%;
    background: var(--herobg);
    border: 0px solid #1f2330;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
    margin: 0;
  }
  img { display: block; width: 100%; height: auto; background: #0c0e14; }
  figcaption { padding: 10px 12px; font-size: 15px; color: #c8d0dd; }
  .t { font-size: 16px; font-weight: 600; color: var(--titletext2); }
  .c { margin-top: 4px; color: var(--smalltext); }
</style>